// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "ncpwsafe",
	"build": {
		// Path is relative to the devcontainer.json file.
		// Dockerfile.fedora is an alternative with the same toolset.
		"dockerfile": "Dockerfile.ubuntu"
	},

	// Makes a libpwsafe checkout next to this repo available at /workspaces/libpwsafe,
	// for use with the commented SOURCE_DIR line in cmake/ResolveDependencies.cmake.
	// The checkout must exist on the host, or the container will not start.
	"mounts": [
		"type=bind,src=${localWorkspaceFolder}/../libpwsafe,dst=/workspaces/libpwsafe"
	],

	"remoteUser": "vscode"
}
