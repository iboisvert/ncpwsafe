{
  "version": 3,
  "configurePresets": [
    {
        "name":  "base",
        "hidden": true,
        "binaryDir": "${sourceDir}/build",
        "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
    },
    { "name": "debug",    "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release",  "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },

    {
        "name": "linux", "hidden": true,
        "generator": "Unix Makefiles",
        "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },

    {
        "name": "x64-linux-gcc", "hidden": true, "inherits": "linux",
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-linux-gcc.cmake"
        }
    },
    { "name": "x64-linux-gcc-debug", "inherits": [ "base", "x64-linux-gcc", "debug" ] },
    { "name": "x64-linux-gcc-release", "inherits": [ "base", "x64-linux-gcc", "release" ] },
    {
        "name": "x64-linux-gcc-static-release",
        "description": "Release build for distribution: every dependency but glibc linked statically",
        "inherits": [ "base", "x64-linux-gcc", "release" ],
        "cacheVariables": { "NCPWSAFE_STATIC_DEPS": "ON" }
    },

    {
        "name": "x64-linux-clang", "hidden": true, "inherits": "linux",
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-linux-clang.cmake"
        }
    },
    { "name": "x64-linux-clang-debug", "inherits": [ "base", "x64-linux-clang", "debug" ] },
    { "name": "x64-linux-clang-release", "inherits": [ "base", "x64-linux-clang", "release" ] },
    {
        "name": "x64-linux-clang-sanitize",
        "description": "Debug build with AddressSanitizer and UBSan, as in CI",
        "inherits": [ "base", "x64-linux-clang", "debug" ],
        "cacheVariables": { "NCPWSAFE_DEBUG_SANITIZE": "ON" }
    },

    {
        "name": "x64-windows-msvc", "hidden": true,
        "description": "Native Windows build with MSVC, the Windows SDK and vcpkg. Run from a Visual Studio Developer prompt.",
        "generator": "Ninja",
        "architecture": { "value": "x64", "strategy": "external" },
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-windows-msvc.cmake",
            "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
        },
        "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "x64-windows-msvc-debug", "inherits": [ "base", "x64-windows-msvc", "debug" ] },
    {
      "name": "x64-windows-msvc-release",
      "inherits": [ "base", "x64-windows-msvc", "release" ],
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static-release" }
    }
  ],
  "buildPresets": [
    { "name": "x64-linux-gcc-debug", "configurePreset": "x64-linux-gcc-debug" },
    { "name": "x64-linux-gcc-release", "configurePreset": "x64-linux-gcc-release" },
    { "name": "x64-linux-gcc-static-release", "configurePreset": "x64-linux-gcc-static-release" },
    { "name": "x64-linux-clang-debug", "configurePreset": "x64-linux-clang-debug" },
    { "name": "x64-linux-clang-release", "configurePreset": "x64-linux-clang-release" },
    { "name": "x64-linux-clang-sanitize", "configurePreset": "x64-linux-clang-sanitize" },
    { "name": "x64-windows-msvc-debug", "configurePreset": "x64-windows-msvc-debug" },
    { "name": "x64-windows-msvc-release", "configurePreset": "x64-windows-msvc-release" }
  ],
  "testPresets": [
    { "name": "x64-linux-gcc-debug", "configurePreset": "x64-linux-gcc-debug" },
    { "name": "x64-linux-gcc-release", "configurePreset": "x64-linux-gcc-release" },
    { "name": "x64-linux-gcc-static-release", "configurePreset": "x64-linux-gcc-static-release", "output": { "outputOnFailure": true } },
    { "name": "x64-linux-clang-debug", "configurePreset": "x64-linux-clang-debug" },
    { "name": "x64-linux-clang-release", "configurePreset": "x64-linux-clang-release" },
    {
        "name": "x64-linux-clang-sanitize", "configurePreset": "x64-linux-clang-sanitize",
        "description": "UBSan only prints what it finds unless halt_on_error is set, which makes the test fail",
        "output": { "outputOnFailure": true },
        "environment": { "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1" }
    },
    { "name": "x64-windows-msvc-debug", "configurePreset": "x64-windows-msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "x64-windows-msvc-release", "configurePreset": "x64-windows-msvc-release", "output": { "outputOnFailure": true } }
  ]
}
